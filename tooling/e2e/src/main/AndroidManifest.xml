<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="tech.onova.offlinetranslator" />
    </queries>

    <application android:label="PolyTools E2E">
        <!-- The emulator image has no system file dialog, so this stands in for it (FilePickerStandIn.kt). -->
        <activity
            android:name=".FilePickerStandIn"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <provider
            android:name=".StandInFilesProvider"
            android:authorities="tech.onova.offlinetranslator.e2e.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
