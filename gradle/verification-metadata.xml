<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spec 082 research R1: the one dependency that comes from outside Google's and Maven Central's repositories, sherpa-onnx's
  Android library from its GitHub release, is checked against the SHA-256 below. Every other group is trusted as before.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com[.]k2fsa[.]sherpa[.]onnx$).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.k2fsa.sherpa.onnx" name="sherpa-onnx-static-link-onnxruntime" version="1.13.8">
         <artifact name="sherpa-onnx-static-link-onnxruntime-1.13.8.aar">
            <sha256 value="b22c3fc1b6a45666d28892bb2f7694beeb77a8362d7ebd77c1a5431ec9435471" origin="GitHub release v1.13.8, its published digest"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
